# Variables read by the workflow (see deploy/compose.yml). Copy to .env, which git ignores.
JWT_PUBLIC_KEY=<pem-public-key-one-line>
# This workflow's own service credential (SERVICE role): used for every call to a participant,
# never the person's token, which could expire in the middle of a compensation.
SERVICE_TOKEN=<service-token-with-SERVICE-role>

SAGA_MAX_ATTEMPTS=3
SAGA_LEASE=PT30S
SAGA_RESUME_AFTER=PT30S
SAGA_RESUME_EVERY=PT30S
HTTP_TIMEOUT=PT5S
HTTP_ATTEMPTS=3

# Optional for the Redis store integration test (skipped when empty):
# TEST_REDIS_PORT=6379
